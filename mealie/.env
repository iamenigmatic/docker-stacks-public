POSTGRES_USER=yourdbusername
POSTGRES_PASSWORD=yourdbpass
SMTP_HOST=yoursmtphost
SMTP_FROM_EMAIL=youremail
SMTP_USER=youremail
SMTP_PASSWORD=yoursmtppass
OIDC_AUTH_ENABLED=true
OIDC_SIGNUP_ENABLED=true
OIDC_CLIENT_ID=<client id from pocket ID>
OIDC_CLIENT_SECRET=<client secret from pocket ID>
OAUTH_PROVIDER_NAME=PocketID
OIDC_CONFIGURATION_URL=https://<your pocket id url>/.well-known/openid-configuration
OIDC_USER_CLAIM=email
OIDC_ADMIN_GROUP=Home # Figure this out for yourself but doing this will add all users to the same recipes area, family style.
BASE_URL=https://mealie.example.com
OIDC_AUTO_REDIRECT=true
OIDC_REMEMBER_ME=true
ALLOW_PASSWORD_LOGIN=false